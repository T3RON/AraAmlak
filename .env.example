# ─── آرا املاک — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=ara_amlak.settings.development
SECRET_KEY=change-me-generate-with-python-manage-generatekey
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgis://ara:ara_secret@db:5432/ara_amlak
POSTGRES_DB=ara_amlak
POSTGRES_USER=ara
POSTGRES_PASSWORD=ara_secret
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ── Web ───────────────────────────────────────────────────────────────────────
WEB_PORT=8000

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-with-fernet

# ── Celery ────────────────────────────────────────────────────────────────────
# Uses REDIS_URL as broker; no extra config needed for development

# ── SMS (phase 2 — stub in phase 1) ──────────────────────────────────────────
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_LINE_NUMBER=

# ── Optional: Sentry ─────────────────────────────────────────────────────────
# SENTRY_DSN=
